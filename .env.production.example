# Referencia de las variables de la APP en Vercel. No contiene credenciales reales.
# Configurar en Settings > Environment Variables; no copiar este archivo a .env.
DEMO_MODE=false
# La integracion de Neon proporciona DATABASE_URL. No sustituir por localhost.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Solo para fotografias propias. Bucket S3 privado, existente y accesible.
# En AWS S3 se puede omitir S3_ENDPOINT para usar el endpoint de la region.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# DATABASE_CA_CERT: solo si el proveedor exige una CA personalizada.
# ADMIN_EMAIL / ADMIN_PASSWORD: alta puntual por CLI, no variables permanentes.
# APP_URL: no se utiliza en NOVA.
# PG* / POSTGRES_* / NEON_*: pueden ser anadidas por Neon; no copiarlas a mano.
