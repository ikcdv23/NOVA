{
  "name": "nova-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "media:cleanup": "tsx --env-file=.env scripts/cleanup-media.ts",
    "railway:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/stix-two-text": "^5.2.8",
    "next": "^16.0.10",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
