# Plantilla LOCAL: copiar a .env. Estos valores no se suben a Vercel.
# En demo no se usa PostgreSQL y el acceso de administrador esta deshabilitado.
DEMO_MODE=true
DATABASE_URL=postgresql://nova:nova_local@127.0.0.1:5433/nova
# Opcional: CA de PostgreSQL si el proveedor lo exige (PEM con saltos \n).
DATABASE_CA_CERT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MinIO local: solo necesario para probar fotografias propias en modo real.
# Nunca anadir NEXT_PUBLIC_ a credenciales privadas.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-images
S3_ACCESS_KEY_ID=nova_local
S3_SECRET_ACCESS_KEY=nova_local_password
S3_FORCE_PATH_STYLE=true
# Solo para admin:create. Quitar ADMIN_PASSWORD despues de crear la cuenta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
