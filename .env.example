# Copy to .env. Demo is explicit and never connects to PostgreSQL.
DEMO_MODE=true
DATABASE_URL=postgresql://nova:nova_local@127.0.0.1:5433/nova
# Optional trusted CA for hosted PostgreSQL (literal PEM with escaped newlines).
DATABASE_CA_CERT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required to upload photos; private S3-compatible bucket. Never prefix secrets with NEXT_PUBLIC_.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-images
S3_ACCESS_KEY_ID=nova_local
S3_SECRET_ACCESS_KEY=nova_local_password
S3_FORCE_PATH_STYLE=true
# Only used by admin:create. Remove from .env after creating the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
